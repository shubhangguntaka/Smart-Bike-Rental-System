# ==========================================
# Frontend Environment Configuration Example
# ==========================================

# Backend Spring Boot API Base URL (Default local backend runs on port 8888)
VITE_API_BASE_URL=http://localhost:8888/api

# Application Name
VITE_APP_NAME="Bike Rental System"

# Optional: Google Maps JavaScript API Browser Key (if external maps provider is configured)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Razorpay Public Key ID (Client-side checkout)
VITE_RAZORPAY_KEY_ID=

# Optional: Cloudinary Cloud Name (Client image uploads)
VITE_CLOUDINARY_CLOUD_NAME=